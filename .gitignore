# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
__pycache__/

# eval runtime artifacts — regenerate by re-running evals/harness/run_evals.py
# (golden sets, criteria, and harness code ARE committed)
/evals/logs/
modules/bmad-jev/**/__pycache__/

# module-copy runtime decision logs (written by skills at call time)
modules/bmad-jev/**/logs/

# party-mode session memories — runtime state, per-machine
_bmad-output/party-mode/

# local credentials (template: .env.example)
.env

# Node/TypeScript tooling (dev only; runtime scripts have zero npm deps)
node_modules/
