# JevBMAD credentials and provider configuration.
# Copy to `.env` and fill in values. `.env` is gitignored - never commit it.

# --- Jev provider credentials (either one enables live calls) ---------------
# TypeSafe direct (recommended): create at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# OpenRouter fallback (used when TYPESAFE_API_KEY is unset): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Optional decision-assist overrides (defaults follow the provider) ------
# mode: off (default, zero network calls) | shadow (evaluate only) | suggest
#BMAD_DECISION_ASSIST_MODE=off
#BMAD_DECISION_ASSIST_MODEL=
#BMAD_DECISION_ASSIST_ENDPOINT=
