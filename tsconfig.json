{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "_bmad/custom/bmad-jev/**/*.ts",
    "modules/**/*.ts",
    "router/**/*.ts",
    "evals/**/*.ts"
  ]
}